{
  "name": "clauselock",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:program": "anchor build --arch v1",
    "test:program": "cargo test -p clauselock",
    "test:sdk": "tsx sdk/test.ts",
    "typecheck": "tsc -p .",
    "test": "npm run test:program && npm run test:sdk",
    "terms": "tsx scripts/terms.ts",
    "demo": "tsx scripts/demo.ts",
    "vectors": "python3 scripts/gen_vectors.py",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web",
    "test:e2e": "playwright test -c web/playwright.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.98.0",
    "buffer": "^6.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  }
}
